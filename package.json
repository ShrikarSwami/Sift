{
  "name": "sift",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "serve:install": "cp scripts/com.slhj.sift-dev.plist ~/Library/LaunchAgents/ && launchctl load -w ~/Library/LaunchAgents/com.slhj.sift-dev.plist",
    "serve:stop": "launchctl unload -w ~/Library/LaunchAgents/com.slhj.sift-dev.plist",
    "serve:restart": "launchctl kickstart -k gui/$(id -u)/com.slhj.sift-dev",
    "serve:status": "launchctl list | grep com.slhj.sift-dev || echo 'not running'",
    "serve:logs": "tail -f ~/Library/Logs/sift-dev.log"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "framer-motion": "^13.4.2",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  },
  "private": true,
  "type": "module"
}
