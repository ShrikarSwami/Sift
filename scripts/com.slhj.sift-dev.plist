<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.slhj.sift-dev</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/shrishrimacbook/Projects/Sift/scripts/dev-server.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/shrishrimacbook/Projects/Sift</string>

  <!-- Start at login and restart automatically if it ever exits. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>

  <key>StandardOutPath</key>
  <string>/Users/shrishrimacbook/Library/Logs/sift-dev.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/shrishrimacbook/Library/Logs/sift-dev.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
