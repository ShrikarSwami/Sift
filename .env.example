# Local inference node. Nothing here leaves your network: speech-to-text and the
# language model both run on this machine.
#
# Copy to .env.local (gitignored) and fill in your own values.

# SSH target for the node running Ollama + whisper.cpp.
SIFT_NODE_HOST=user@hostname

# Ollama model tag used for scoring.
SIFT_NODE_MODEL=your-model:tag

# How the node and model are described in the UI. Keep generic when presenting.
SIFT_NODE_LABEL=local node
SIFT_MODEL_LABEL=local model

# whisper.cpp on the node.
SIFT_WHISPER_BIN=~/whisper.cpp/build/bin/whisper-cli
SIFT_WHISPER_MODEL=~/whisper.cpp/models/ggml-tiny.en.bin
SIFT_WHISPER_THREADS=8

# -1 keeps the model resident so a demo never pays a cold load.
SIFT_KEEP_ALIVE=-1
